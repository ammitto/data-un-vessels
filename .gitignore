# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store

# Logs
*.log
update.log

# Ruby
.vendor/
.bundle/
vendor/
Gemfile.lock

# IDE
.idea/

# Local development
CLAUDE.md

# Downloaded data (keep directory)
downloaded/*
!downloaded/.gitkeep

# processed/ is deliberately NOT ignored. The daily fetch writes the
# parsed vessel YAML there, and ignoring it meant every run rebuilt the
# same files, saw no git changes, and committed nothing — so the
# harmonizer downstream found no input and failed the whole publish for
# every other source too. The fetch output is the product of this repo,
# not a build artefact.
